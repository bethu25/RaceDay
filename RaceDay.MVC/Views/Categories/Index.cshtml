@using System.Text.Json

@{
    ViewData["Title"] = "Manage Categories";
    int eventId = ViewBag.EventID;
}

<div class="container mt-5">

    <!-- Page heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Manage Categories</h2>
            <p class="text-muted">Manage participant categories for this event.</p>
        </div>

        <a asp-controller="Categories"
           asp-action="Create"
           asp-route-eventId="@eventId"
           class="btn btn-success">
            + Add Category
        </a>
    </div>

    <!-- Success message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Error message -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- Display categories -->
    @if (Model is List<JsonElement> categories && categories.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Entry Fee</th>
                        <th>Maximum Participants</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (JsonElement category in categories)
                    {
                        <tr>
                            <td>
                                @category.GetProperty("categoryName").GetString()
                            </td>

                            <td>
                                @category.GetProperty("distance").GetDecimal() km
                            </td>

                            <td>
                                R @category.GetProperty("entryFee").GetDecimal().ToString("N2")
                            </td>

                            <td>
                                @category.GetProperty("maxParticipants").GetInt32()
                            </td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@category.GetProperty("categoryID").GetInt32()"
                                       asp-route-eventId="@eventId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@category.GetProperty("categoryID").GetInt32()"
                                          asp-route-eventId="@eventId"
                                          method="post"
                                          onsubmit="return confirm('Delete this category?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No categories have been created for this event yet.
        </div>
    }

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Back to Events
    </a>

</div>