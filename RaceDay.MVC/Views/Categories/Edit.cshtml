@model RaceDay.MVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Category</h4>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        Update the category information below.
                    </p>

                    <form asp-controller="Categories"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Keep the category and event IDs. -->
                        <input type="hidden" asp-for="CategoryID" />
                        <input type="hidden" asp-for="EventID" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <!-- Category name -->
                        <div class="mb-3">
                            <label asp-for="CategoryName"
                                   class="form-label">
                                Category Name
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger"></span>
                        </div>

                        <!-- Category distance -->
                        <div class="mb-3">
                            <label asp-for="Distance"
                                   class="form-label">
                                Distance (km)
                            </label>

                            <input asp-for="Distance"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />

                            <span asp-validation-for="Distance"
                                  class="text-danger"></span>
                        </div>

                        <!-- Entry fee -->
                        <div class="mb-3">
                            <label asp-for="EntryFee"
                                   class="form-label">
                                Entry Fee (R)
                            </label>

                            <input asp-for="EntryFee"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />

                            <span asp-validation-for="EntryFee"
                                  class="text-danger"></span>
                        </div>

                        <!-- Maximum participants -->
                        <div class="mb-3">
                            <label asp-for="MaxParticipants"
                                   class="form-label">
                                Maximum Participants
                            </label>

                            <input asp-for="MaxParticipants"
                                   class="form-control"
                                   type="number" />

                            <span asp-validation-for="MaxParticipants"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-controller="Categories"
                               asp-action="Index"
                               asp-route-eventId="@Model.EventID"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}