@model RaceDay.MVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-5">

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h2 class="fw-bold mb-3">Create Event Category</h2>

            <p class="text-muted">
                Add a participation category to your event.
            </p>

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input type="hidden" asp-for="EventID" />

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label">
                        Category Name
                    </label>

                    <input asp-for="CategoryName"
                           class="form-control"
                           placeholder="Example: 10 km Race" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Distance" class="form-label">
                        Distance (km)
                    </label>

                    <input asp-for="Distance"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="Distance"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EntryFee" class="form-label">
                        Entry Fee (R)
                    </label>

                    <input asp-for="EntryFee"
                           type="number"
                           step="0.01"
                           class="form-control" />

                    <span asp-validation-for="EntryFee"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="MaxParticipants" class="form-label">
                        Maximum Participants
                    </label>

                    <input asp-for="MaxParticipants"
                           type="number"
                           class="form-control" />

                    <span asp-validation-for="MaxParticipants"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Category
                </button>

                <a asp-action="Index"
                   asp-route-eventId="@Model.EventID"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}