@using System.Text.Json
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Upcoming Events";

    // Retrieves the current user's role and ID.
    string? userRole = Context.Session.GetString("UserRole");
    int? userID = Context.Session.GetInt32("UserID");
}

<div class="container mt-5 mb-5">

    <!-- Success message. -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Error message. -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Page heading. -->
    <div class="events-heading text-center mb-5">

        <span class="events-label">DISCOVER RACEDAY</span>

        <h1>Find Your Next Challenge</h1>

        <p>
            Discover exciting running, walking and cycling events.
            Your next adventure starts here.
        </p>

        <!-- Organisers can create events. -->
        @if (userRole == "Organiser")
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn create-button mt-3">
                + Create New Event
            </a>
        }

    </div>

    <!-- API error message. -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <h5>Unable to load events</h5>
            <p>@ViewBag.ErrorMessage</p>
        </div>
    }

    else if (Model is JsonElement events &&
             events.ValueKind == JsonValueKind.Array)
    {
        @if (events.GetArrayLength() == 0)
        {
            <div class="alert alert-info text-center">
                No upcoming events are currently available.
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (JsonElement raceEvent in events.EnumerateArray())
                {
                    // Retrieves the event ID.
                    int eventId = raceEvent.GetProperty("eventID").GetInt32();

                    // Retrieves event information.
                    string eventName =
                        raceEvent.GetProperty("eventName").GetString()
                        ?? "RaceDay Event";

                    string eventType =
                        raceEvent.GetProperty("eventType").GetString()
                        ?? "Event";

                    string location =
                        raceEvent.GetProperty("location").GetString()
                        ?? "Location unavailable";

                    // Retrieves the event description.
                    string description =
                        raceEvent.TryGetProperty(
                            "description", out JsonElement descriptionElement)
                        ? descriptionElement.GetString()
                            ?? "Discover this exciting RaceDay event."
                        : "Discover this exciting RaceDay event.";

                    // Converts the API date into a readable string.
                    string formattedEventDate =
                        raceEvent.GetProperty("eventDate")
                        .GetDateTime()
                        .ToString("dd MMMM yyyy");

                    // Retrieves the event distance.
                    decimal distance =
                        raceEvent.GetProperty("distance").GetDecimal();

                    // Retrieves the event banner filename.
                    string? bannerImage = null;

                    if (raceEvent.TryGetProperty(
                        "bannerImage", out JsonElement banner))
                    {
                        bannerImage = banner.GetString();
                    }

                    // Checks whether the organiser owns this event.
                    bool ownsEvent = false;

                    if (userRole == "Organiser" &&
                        userID.HasValue &&
                        raceEvent.TryGetProperty(
                            "organiserID", out JsonElement organiserID))
                    {
                        ownsEvent =
                            organiserID.GetInt32() == userID.Value;
                    }

                    <div class="col-lg-4 col-md-6">

                        <div class="event-card">

                            <!-- Event banner image. -->
                            @if (!string.IsNullOrWhiteSpace(bannerImage))
                            {
                                <img src="@Url.Action("Banner", "Events", new { id = eventId })"
                                     class="event-image"
                                     alt="@eventName" />
                            }
                            else
                            {
                                <div class="event-placeholder">
                                    <span>🏆</span>
                                    <p>RaceDay Event</p>
                                </div>
                            }

                            <div class="event-content">

                                <!-- Event category. -->
                                <span class="event-badge">
                                    @eventType
                                </span>

                                <!-- Event name. -->
                                <h4 class="event-title">
                                    @eventName
                                </h4>

                                <!-- Event description. -->
                                <p class="event-description">
                                    @description
                                </p>

                                <hr />

                                <!-- Event date. -->
                                <div class="event-detail">
                                    <span>📅</span>

                                    <div>
                                        <small>EVENT DATE</small>

                                        <p>@formattedEventDate</p>
                                    </div>
                                </div>

                                <!-- Event location. -->
                                <div class="event-detail">
                                    <span>📍</span>

                                    <div>
                                        <small>LOCATION</small>

                                        <p>@location</p>
                                    </div>
                                </div>

                                <!-- Event distance. -->
                                <div class="event-detail">
                                    <span>🏃</span>

                                    <div>
                                        <small>DISTANCE</small>

                                        <p>@distance km</p>
                                    </div>
                                </div>

                            </div>

                            <!-- Event action buttons. -->
                            <div class="event-actions">

                                <!-- View event button. -->
                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@eventId"
                                   class="btn view-button w-100 mb-2">
                                    View Event →
                                </a>

                                <!-- Organiser management buttons. -->
                                @if (ownsEvent)
                                {
                                    <div class="d-flex gap-2 mb-2">

                                        <a asp-controller="Events"
                                           asp-action="Edit"
                                           asp-route-id="@eventId"
                                           class="btn edit-button w-50">
                                            Edit
                                        </a>

                                        <form asp-controller="Events"
                                              asp-action="Delete"
                                              asp-route-id="@eventId"
                                              method="post"
                                              class="w-50"
                                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn delete-button w-100">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                    <a asp-controller="Categories"
                                       asp-action="Index"
                                       asp-route-eventId="@eventId"
                                       class="btn category-button w-100">
                                        Manage Categories
                                    </a>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            The events information could not be displayed.
        </div>
    }

</div>


<!-- RaceDay event card styling. -->
<style>

    /* Brand colours. */
    :root {
        --raceday-blue: #73C2FB;
        --raceday-navy: #17264F;
        --raceday-yellow: #FFC107;
        --raceday-light: #EAF5FE;
    }

    /* Page heading. */
    .events-heading h1 {
        color: var(--raceday-navy);
        font-size: 38px;
        font-weight: 800;
        margin-top: 12px;
    }

    .events-heading p {
        color: #687386;
        font-size: 17px;
    }

    .events-label {
        color: #357DBB;
        font-weight: 700;
        letter-spacing: 3px;
        font-size: 13px;
    }

    /* Create event button. */
    .create-button {
        background: var(--raceday-yellow);
        color: var(--raceday-navy);
        font-weight: 700;
        padding: 11px 25px;
        border-radius: 8px;
    }

        .create-button:hover {
            background: #e5aa00;
            color: var(--raceday-navy);
        }

    /* Main event card. */
    .event-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        height: 100%;
        border: 1px solid #E5E9F2;
        box-shadow: 0 5px 18px rgba(23, 38, 79, 0.08);
        transition: transform 0.3s, box-shadow 0.3s;
        display: flex;
        flex-direction: column;
    }

        .event-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 28px rgba(23, 38, 79, 0.16);
        }

    /* Event image. */
    .event-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
    }

    /* Placeholder when no image exists. */
    .event-placeholder {
        height: 210px;
        background: var(--raceday-light);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--raceday-navy);
    }

        .event-placeholder span {
            font-size: 55px;
        }

        .event-placeholder p {
            font-weight: 700;
            margin-top: 10px;
        }

    /* Card information. */
    .event-content {
        padding: 22px;
        flex-grow: 1;
    }

    .event-badge {
        display: inline-block;
        background: var(--raceday-light);
        color: #245A91;
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 13px;
    }

    .event-title {
        color: var(--raceday-navy);
        font-weight: 800;
        font-size: 21px;
        margin-bottom: 10px;
    }

    .event-description {
        color: #687386;
        font-size: 14px;
        line-height: 1.7;
        min-height: 48px;
    }

    .event-content hr {
        border-color: #E5E9F2;
        margin: 18px 0;
    }

    /* Event details. */
    .event-detail {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 13px;
    }

        .event-detail > span {
            font-size: 21px;
        }

        .event-detail small {
            color: #8490A3;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .event-detail p {
            color: var(--raceday-navy);
            font-size: 14px;
            font-weight: 600;
            margin: 2px 0 0;
        }

    /* Card buttons. */
    .event-actions {
        padding: 0 22px 22px;
    }

    .view-button {
        background: var(--raceday-navy);
        color: white;
        font-weight: 700;
        padding: 11px;
        border-radius: 8px;
    }

        .view-button:hover {
            background: #263F77;
            color: white;
        }

    .edit-button {
        background: var(--raceday-yellow);
        color: var(--raceday-navy);
        font-weight: 700;
    }

        .edit-button:hover {
            background: #e5aa00;
            color: var(--raceday-navy);
        }

    .delete-button {
        background: #DC3545;
        color: white;
        font-weight: 700;
    }

        .delete-button:hover {
            background: #BB2635;
            color: white;
        }

    .category-button {
        background: var(--raceday-light);
        color: var(--raceday-navy);
        font-weight: 700;
    }

        .category-button:hover {
            background: var(--raceday-blue);
            color: var(--raceday-navy);
        }

    /* Mobile responsiveness. */
    @@media (max-width: 768px) {

        .events-heading h1 {
            font-size: 29px;
        }

        .event-image {
            height: 190px;
        }
    }

</style>