@using System.Text.Json

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-5">

    <!-- Page heading -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">Discover RaceDay Events</h1>
        <p class="text-muted">
            Find your next running, walking or cycling challenge.
        </p>
    </div>

    <!-- Display an error if the API request failed -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <h5>Unable to load events</h5>
            <p>@ViewBag.ErrorMessage</p>
        </div>
    }
    else if (Model is JsonElement events &&
             events.ValueKind == JsonValueKind.Array)
    {
        <!-- Check whether the API returned any events -->
        @if (events.GetArrayLength() == 0)
        {
            <div class="alert alert-info text-center">
                No upcoming events are currently available.
            </div>
        }
        else
        {
            <!-- Display each event returned by the API -->
            <div class="row">

                @foreach (JsonElement raceEvent in events.EnumerateArray())
                {
                    <div class="col-md-4 mb-4">

                        <div class="card shadow-sm h-100">

                            <div class="card-body">

                                <!-- Event category -->
                                <span class="badge bg-primary mb-3">
                                    @raceEvent.GetProperty("eventType").GetString()
                                </span>

                                <!-- Event name -->
                                <h5 class="card-title fw-bold">
                                    @raceEvent.GetProperty("eventName").GetString()
                                </h5>

                                <!-- Event description -->
                                <p class="text-muted">
                                    @raceEvent.GetProperty("description").GetString()
                                </p>

                                <hr />

                                <!-- Event date -->
                                <p>
                                    <strong>Date:</strong>
                                    @{
                                        DateTime eventDate = raceEvent
                                            .GetProperty("eventDate")
                                            .GetDateTime();
                                    }
                                    @eventDate.ToString("dd MMMM yyyy")
                                </p>

                                <!-- Event location -->
                                <p>
                                    <strong>Location:</strong>
                                    @raceEvent.GetProperty("location").GetString()
                                </p>

                                <!-- Event distance -->
                                <p>
                                    <strong>Distance:</strong>
                                    @raceEvent.GetProperty("distance").GetDouble() km
                                </p>

                            </div>

                            <!-- Event action -->
                            <div class="card-footer bg-white">
                                <button class="btn btn-primary w-100" disabled>
                                    View Event
                                </button>
                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }
    else
    {
        <!-- Display a fallback message if the API response is unexpected -->
        <div class="alert alert-warning">
            The events information could not be displayed.
        </div>
    }

</div>