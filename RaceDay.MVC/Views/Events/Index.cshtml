@using System.Text.Json
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Upcoming Events";

    // Retrieves the current user's role and ID from the MVC session.
    string? userRole = Context.Session.GetString("UserRole");
    int? userID = Context.Session.GetInt32("UserID");
}

<div class="container mt-5">

    <!-- Display success and error messages. -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Page heading. -->
    <div class="text-center mb-5">
        <h1 class="fw-bold">Discover RaceDay Events</h1>

        <p class="text-muted">
            Find your next running, walking or cycling challenge.
        </p>

        <!-- Only organisers can create events. -->
        @if (userRole == "Organiser")
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-success mt-2">
                + Create New Event
            </a>
        }
    </div>

    <!-- Display an error if the API request failed. -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <h5>Unable to load events</h5>
            <p>@ViewBag.ErrorMessage</p>
        </div>
    }
    else if (Model is JsonElement events &&
             events.ValueKind == JsonValueKind.Array)
    {
        <!-- Check whether the API returned any events. -->
        @if (events.GetArrayLength() == 0)
        {
            <div class="alert alert-info text-center">
                No upcoming events are currently available.
            </div>
        }
        else
        {
            <!-- Display each event returned by the API. -->
            <div class="row">

                @foreach (JsonElement raceEvent in events.EnumerateArray())
                {
                    <div class="col-md-4 mb-4">

                        <div class="card shadow-sm h-100">

                            <div class="card-body">

                                <!-- Event category. -->
                                <span class="badge bg-primary mb-3">
                                    @raceEvent.GetProperty("eventType").GetString()
                                </span>

                                <!-- Event name. -->
                                <h5 class="card-title fw-bold">
                                    @raceEvent.GetProperty("eventName").GetString()
                                </h5>

                                <!-- Event description. -->
                                <p class="text-muted">
                                    @(raceEvent.TryGetProperty("description", out JsonElement description)
                                        ? description.GetString()
                                        : "No description available.")
                                </p>

                                <hr />

                                <!-- Event date. -->
                                <p>
                                    <strong>Date:</strong>

                                    @{
                                        DateTime eventDate = raceEvent
                                            .GetProperty("eventDate")
                                            .GetDateTime();
                                    }

                                    @eventDate.ToString("dd MMMM yyyy")
                                </p>

                                <!-- Event location. -->
                                <p>
                                    <strong>Location:</strong>
                                    @raceEvent.GetProperty("location").GetString()
                                </p>

                                <!-- Event distance. -->
                                <p>
                                    <strong>Distance:</strong>
                                    @raceEvent.GetProperty("distance").GetDouble() km
                                </p>

                            </div>

                            <!-- Event action buttons. -->
                            <div class="card-footer bg-white border-0">

                                <!-- All users can view event details. -->
                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@raceEvent.GetProperty("eventID").GetInt32()"
                                   class="btn btn-primary w-100 mb-2">
                                    View Event
                                </a>

                                @{
                                    // Checks whether the current organiser owns this event.
                                    bool ownsEvent = false;

                                    if (userRole == "Organiser" &&
                                        userID.HasValue &&
                                        raceEvent.TryGetProperty("organiserID", out JsonElement organiserID))
                                    {
                                        ownsEvent = organiserID.GetInt32() == userID.Value;
                                    }
                                }

                                <!-- Only the event's organiser can manage it. -->
                                @if (ownsEvent)
                                {
                                    <div class="d-flex gap-2 mb-2">

                                        <!-- Edit event button. -->
                                        <a asp-controller="Events"
                                           asp-action="Edit"
                                           asp-route-id="@raceEvent.GetProperty("eventID").GetInt32()"
                                           class="btn btn-warning w-50">
                                            Edit
                                        </a>

                                        <!-- Delete event using a POST request. -->
                                        <form asp-controller="Events"
                                              asp-action="Delete"
                                              asp-route-id="@raceEvent.GetProperty("eventID").GetInt32()"
                                              method="post"
                                              class="w-50"
                                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger w-100">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                    <!-- Organiser can manage categories for this event. -->
                                    <a asp-controller="Categories"
                                       asp-action="Index"
                                       asp-route-eventId="@raceEvent.GetProperty("eventID").GetInt32()"
                                       class="btn btn-info w-100">
                                        Manage Categories
                                    </a>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
    }
    else
    {
        <!-- Displays a fallback message if the API response is unexpected. -->
        <div class="alert alert-warning">
            The events information could not be displayed.
        </div>
    }

</div>