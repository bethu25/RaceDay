@using System.Text.Json

@{
    ViewData["Title"] = "Event Details";

    // Retrieve the event information passed by the controller.
    JsonElement eventDetails = Model;

    // Retrieve the categories passed through ViewBag.
    List<JsonElement> categories = ViewBag.Categories
        as List<JsonElement> ?? new List<JsonElement>();
}

<div class="container mt-5">

    <!-- Event heading -->
    <div class="mb-4">
        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-outline-secondary mb-3">
            &larr; Back to Events
        </a>

        <h1 class="fw-bold">
            @eventDetails.GetProperty("eventName").GetString()
        </h1>

        <span class="badge bg-primary">
            @eventDetails.GetProperty("eventType").GetString()
        </span>
    </div>

    <!-- Event information -->
    <div class="card shadow-sm mb-5">
        <div class="card-body">

            <h4 class="fw-bold mb-3">About This Event</h4>

            <p class="text-muted">
                @eventDetails.GetProperty("description").GetString()
            </p>

            <hr />

            <div class="row">

                <div class="col-md-4 mb-3">
                    <strong>Event Date</strong>
                    <p>
                        @(eventDetails.GetProperty("eventDate")
                            .GetDateTime()
                            .ToString("dd MMMM yyyy"))
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <strong>Location</strong>
                    <p>
                        @eventDetails.GetProperty("location").GetString()
                    </p>
                </div>

                <div class="col-md-4 mb-3">
                    <strong>Distance</strong>
                    <p>
                        @eventDetails.GetProperty("distance").GetDouble() km
                    </p>
                </div>

            </div>

        </div>
    </div>
    <!-- Display successful enrolment messages. -->
@if (TempData["EnrolmentSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["EnrolmentSuccess"]
    </div>
}

<!-- Display enrolment errors. -->
@if (TempData["EnrolmentError"] != null)
{
    <div class="alert alert-danger">
        @TempData["EnrolmentError"]
    </div>
}
    <!-- Available categories -->
    <div class="mb-4">

        <h3 class="fw-bold">Available Categories</h3>

        <p class="text-muted">
            Choose the category that suits your race.
        </p>

        @if (ViewBag.CategoryError != null)
        {
            <div class="alert alert-danger">
                @ViewBag.CategoryError
            </div>
        }
        else if (categories.Count == 0)
        {
            <div class="alert alert-info">
                No categories are currently available for this event.
            </div>
        }
        else
        {
            <div class="row">

                @foreach (JsonElement category in categories)
                {
                    <div class="col-md-4 mb-4">

                        <div class="card shadow-sm h-100">

                            <div class="card-body">

                                <h5 class="fw-bold">
                                    @category.GetProperty("categoryName").GetString()
                                </h5>

                                <p>
                                    <strong>Distance:</strong>
                                    @category.GetProperty("distance").GetDouble() km
                                </p>

                                <p>
                                    <strong>Entry Fee:</strong>
                                    R @category.GetProperty("entryFee").GetDecimal().ToString("N2")
                                </p>

                                <p>
                                    <strong>Maximum Participants:</strong>
                                    @category.GetProperty("maxParticipants").GetInt32()
                                </p>

                                <!-- Submit the selected category for enrolment. -->
                                <form asp-controller="Enrolments"
                                      asp-action="Enrol"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <!-- Send the selected category ID to the controller. -->
                                    <input type="hidden"
                                           name="categoryId"
                                           value="@category.GetProperty("categoryID").GetInt32()" />

                                    <!-- Send the current event ID to the controller. -->
                                    <input type="hidden"
                                           name="eventId"
                                           value="@eventDetails.GetProperty("eventID").GetInt32()" />

                                    <button type="submit" class="btn btn-primary w-100">
                                        Enrol Now
                                    </button>
                                </form>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>