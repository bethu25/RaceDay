@using System.Text.Json

@{
    ViewData["Title"] = "Home";

    // Retrieves the events supplied by HomeController.
    List<JsonElement> upcomingEvents =
        ViewBag.UpcomingEvents as List<JsonElement>
        ?? new List<JsonElement>();
}

<!-- Main RaceDay welcome section -->
<section class="raceday-hero">
    <div class="hero-content">

        <span class="hero-label">WELCOME TO RACEDAY</span>

        <h1>
            YOUR RACE.<br />
            YOUR JOURNEY.<br />
            <span>YOUR DAY.</span>
        </h1>

        <p>
            Discover exciting running, walking and cycling events.
            Find your next challenge, register for events and track
            your racing achievements with RaceDay.
        </p>

        <div class="hero-buttons">
            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-warning btn-lg">
                Explore Events
            </a>

            <a href="#activities" class="btn btn-outline-dark btn-lg">
                Discover More
            </a>
        </div>

    </div>
</section>


<!-- Activities section -->
<section class="container my-5" id="activities">

    <div class="text-center mb-5">
        <h2 class="section-heading">Find Your Next Challenge</h2>

        <p class="text-muted">
            Whatever your pace, there is an event waiting for you.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="activity-card">
                <div class="activity-icon">🏃</div>
                <h4>Running Events</h4>
                <p>
                    Challenge yourself with exciting running events
                    and push your limits.
                </p>
                <a asp-controller="Events" asp-action="Index"
                   class="activity-link">Explore Events →</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="activity-card">
                <div class="activity-icon">🚶</div>
                <h4>Walking Events</h4>
                <p>
                    Enjoy outdoor activities, stay active and
                    participate at your own pace.
                </p>
                <a asp-controller="Events" asp-action="Index"
                   class="activity-link">Explore Events →</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="activity-card">
                <div class="activity-icon">🚴</div>
                <h4>Cycling Events</h4>
                <p>
                    Get on your bicycle, discover new routes
                    and take on exciting challenges.
                </p>
                <a asp-controller="Events" asp-action="Index"
                   class="activity-link">Explore Events →</a>
            </div>
        </div>

    </div>
</section>


<!-- Upcoming events section -->
<section class="upcoming-section">

    <div class="container">

        <div class="text-center mb-5">

            <span class="upcoming-label">DON'T MISS OUT</span>

            <h2 class="section-heading mt-2">
                Upcoming Events
            </h2>

            <p class="text-muted">
                Discover exciting events and find your next challenge.
            </p>

        </div>

        @if (upcomingEvents.Count > 0)
        {
            <div class="row g-4">

                @foreach (JsonElement raceEvent in upcomingEvents)
                {
                    int eventId = raceEvent.GetProperty("eventID").GetInt32();

                    string eventName =
                        raceEvent.GetProperty("eventName").GetString()
                        ?? "RaceDay Event";

                    string eventType =
                        raceEvent.GetProperty("eventType").GetString()
                        ?? "Event";

                    string location =
                        raceEvent.GetProperty("location").GetString()
                        ?? "Location unavailable";

                    string description =
                        raceEvent.TryGetProperty(
                            "description", out JsonElement eventDescription)
                        ? eventDescription.GetString()
                            ?? "Discover this exciting event."
                        : "Discover this exciting event.";

                    // Convert the API date into a readable date string.
                    string eventDate =
                        raceEvent.GetProperty("eventDate")
                        .GetDateTime()
                        .ToString("dd MMMM yyyy");

                    decimal distance =
                        raceEvent.GetProperty("distance").GetDecimal();

                    // Retrieve the Azure banner image reference.
                    string? bannerImage =
                        raceEvent.TryGetProperty(
                            "bannerImage", out JsonElement banner)
                        ? banner.GetString()
                        : null;

                    <div class="col-lg-4 col-md-6">

                        <div class="home-event-card">

                            <!-- Displays the Azure event banner. -->
                            @if (!string.IsNullOrWhiteSpace(bannerImage))
                            {
                                <img src="@Url.Action("Banner", "Events", new { id = eventId })"
                                     class="home-event-image"
                                     alt="@eventName" />
                            }
                            else
                            {
                                <div class="home-event-placeholder">
                                    🏆
                                    <span>RaceDay Event</span>
                                </div>
                            }

                            <div class="home-event-content">

                                <span class="home-event-badge">
                                    @eventType
                                </span>

                                <h4>@eventName</h4>

                                <p class="home-event-description">
                                    @description
                                </p>

                                <hr />

                                <!-- Displays the already-formatted date. -->
                                <p>
                                    📅 <strong>Date:</strong>
                                    @eventDate
                                </p>

                                <p>
                                    📍 <strong>Location:</strong>
                                    @location
                                </p>

                                <p>
                                    🏃 <strong>Distance:</strong>
                                    @distance km
                                </p>

                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@eventId"
                                   class="btn home-event-button w-100 mt-2">
                                    View Event →
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center">
                <p class="text-muted">
                    No events are currently available.
                </p>
            </div>
        }

        <!-- View all events button. -->
        <div class="text-center mt-5">

            <a asp-controller="Events"
               asp-action="Index"
               class="btn all-events-button btn-lg">
                View All Events →
            </a>

        </div>

    </div>

</section>


<!-- Closing section -->
<section class="raceday-bottom text-center">

    <h2>Every Finish Line Starts Somewhere.</h2>

    <p>Start your journey today with RaceDay.</p>

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-warning btn-lg">
        Find an Event
    </a>

</section>


<!-- Homepage styling -->
<style>

    /* RaceDay brand colours. */
    :root {
        --raceday-blue: #73C2FB;
        --raceday-navy: #17264F;
        --raceday-yellow: #FFC107;
        --raceday-light: #EAF5FE;
    }

    /* Main hero section. */
    .raceday-hero {
        background: linear-gradient(120deg, #73C2FB, #5AADEB);
        color: #17264F;
        padding: 100px 8%;
        min-height: 480px;
        display: flex;
        align-items: center;
    }

    .hero-content {
        max-width: 750px;
    }

    .hero-label {
        color: #17264F;
        font-weight: bold;
        letter-spacing: 3px;
        font-size: 14px;
    }

    .raceday-hero h1 {
        font-size: 55px;
        font-weight: 800;
        line-height: 1.15;
        margin: 20px 0;
    }

        .raceday-hero h1 span {
            color: #FFFFFF;
        }

    .raceday-hero p {
        font-size: 18px;
        line-height: 1.8;
        max-width: 620px;
        color: #17264F;
    }

    .hero-buttons {
        margin-top: 30px;
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }

    /* Section headings. */
    .section-heading {
        color: #17264F;
        font-weight: 750;
        font-size: 32px;
    }

    /* Activity cards. */
    .activity-card {
        background: white;
        border: 1px solid #E5E9F2;
        border-radius: 12px;
        padding: 35px 25px;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .activity-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }

    .activity-icon {
        font-size: 45px;
        margin-bottom: 20px;
    }

    .activity-card h4 {
        color: #17264F;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .activity-card p {
        color: #687386;
        line-height: 1.7;
    }

    .activity-link {
        display: inline-block;
        margin-top: 12px;
        color: #24447E;
        font-weight: bold;
        text-decoration: none;
    }

        .activity-link:hover {
            color: #D99B00;
        }

    /* Upcoming events section. */
    .upcoming-section {
        background: #F5FAFF;
        padding: 75px 0;
    }

    .upcoming-label {
        color: #357DBB;
        font-weight: 700;
        letter-spacing: 3px;
        font-size: 13px;
    }

    /* Event cards. */
    .home-event-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        height: 100%;
        border: 1px solid #E5E9F2;
        box-shadow: 0 5px 18px rgba(23,38,79,0.08);
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .home-event-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 28px rgba(23,38,79,0.15);
        }

    .home-event-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
    }

    .home-event-placeholder {
        height: 210px;
        background: #EAF5FE;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        font-size: 50px;
        color: #17264F;
    }

        .home-event-placeholder span {
            font-size: 16px;
            font-weight: bold;
        }

    .home-event-content {
        padding: 23px;
    }

    .home-event-badge {
        display: inline-block;
        background: #EAF5FE;
        color: #245A91;
        padding: 6px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .home-event-content h4 {
        color: #17264F;
        font-weight: 800;
        font-size: 21px;
        margin-bottom: 12px;
    }

    .home-event-description {
        color: #687386;
        font-size: 14px;
        line-height: 1.7;
        min-height: 48px;
    }

    .home-event-content hr {
        border-color: #E5E9F2;
    }

    .home-event-content p {
        color: #687386;
        font-size: 14px;
        margin-bottom: 12px;
    }

    /* Event buttons. */
    .home-event-button {
        background: #17264F;
        color: white;
        font-weight: 700;
        padding: 11px;
        border-radius: 8px;
    }

        .home-event-button:hover {
            background: #263F77;
            color: white;
        }

    .all-events-button {
        background: #FFC107;
        color: #17264F;
        font-weight: 700;
        padding: 12px 30px;
        border-radius: 8px;
    }

        .all-events-button:hover {
            background: #E5AA00;
            color: #17264F;
        }

    /* Closing section. */
    .raceday-bottom {
        background: #EAF5FE;
        padding: 65px 20px;
        margin-top: 60px;
    }

        .raceday-bottom h2 {
            color: #17264F;
            font-weight: 750;
        }

        .raceday-bottom p {
            color: #687386;
            margin: 15px 0 25px;
        }

    /* Mobile responsiveness. */
    @@media (max-width: 768px) {

        .raceday-hero {
            padding: 65px 25px;
        }

            .raceday-hero h1 {
                font-size: 38px;
            }

            .raceday-hero p {
                font-size: 16px;
            }

        .section-heading {
            font-size: 27px;
        }

        .home-event-image {
            height: 190px;
        }
    }

</style>